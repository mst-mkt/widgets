{
  "name": "widgets",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "pnpm run '/^watch:.*/'",
    "watch:ags": "watchexec -r -w ./src -- ags run ./src/app.ts",
    "watch:css": "unocss './src/**/*.tsx' -o ./src/style.css --watch",
    "gen:css": "unocss './src/**/*.tsx' -o ./src/style.css"
  },
  "dependencies": {
    "unocss-merge": "^0.9.1"
  },
  "devDependencies": {
    "@itt/unocss-preset-gtk": "jsr:^0.0.1",
    "@unocss/cli": "^66.7.0",
    "unocss": "^66.7.0",
    "vite-plus": "^0.1.23"
  },
  "packageManager": "pnpm@11.5.0"
}
