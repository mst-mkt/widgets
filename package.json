{
  "name": "widgets",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "postinstall": "ags types -d . -u",
    "dev": "pnpm run '/^watch:.*/'",
    "watch:ags": "WIDGETS_DEV_CSS=\"$PWD/src/style.css\" watchexec -r -w ./src --ignore '**/style.css' -- ags run ./src/app.tsx",
    "watch:css": "unocss './src/**/*.tsx' -o ./src/style.css --watch",
    "gen:ags": "ags types -d . -u",
    "gen:css": "unocss './src/**/*.tsx' -o ./src/style.css"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "unocss-merge": "^0.9.1"
  },
  "devDependencies": {
    "@itt/unocss-preset-gtk": "jsr:^0.0.1",
    "@unocss/cli": "^66.7.0",
    "oxlint-tsgolint": "^0.23.0",
    "unocss": "^66.7.0",
    "vite-plus": "^0.1.23"
  },
  "packageManager": "pnpm@11.5.0"
}
